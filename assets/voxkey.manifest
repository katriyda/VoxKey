<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest embedded by build.rs (see assets/voxkey.rc).

  Deliberately minimal:
  - asInvoker: VoxKey is a per-user tray application. It must not request
    elevation; UIPI would then block injecting text into normal-integrity
    windows and block adding its tray icon to Explorer.
  - supportedOS: lets GetVersionEx/IsWindows10OrGreater report the real OS
    instead of the compatibility-shim default.
  - No dpiAware entry: winit sets DPI awareness at runtime, and declaring it in
    the manifest makes that API call fail with E_ACCESSDENIED. Leave DPI
    handling to the application.
  - No longPathAware: VoxKey never handles paths near MAX_PATH; enabling it
    only changes behavior for processes that do.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      type="win32"
      name="VoxKey"
      version="@VERSION_DOT4@"
      processorArchitecture="amd64"/>
  <description>VoxKey - hold-to-talk voice input for Windows</description>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
    </application>
  </compatibility>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
